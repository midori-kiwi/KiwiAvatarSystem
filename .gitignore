# ============================================================
# Secrets / private credentials
# ============================================================

# Local environment files may contain API keys or credentials.
.env
.env.*
!.env.example
!.env.sample
!.env.template

# Private keys / signing credentials must never be committed to this public repo.
*.pfx
*.p12
*.pem
*.key
*.keystore
*.jks

# IMPORTANT:
# Do NOT blanket-ignore *.dll or *.exe.
# KiwiAvatarSystem may intentionally track Production artifacts such as
# Assets/Plugins/x86_64/KiwiNativeCamera.dll for provenance/rollback authority.

# ============================================================
# KiwiAvatarSystem - local backups / installers / external artifacts
# ============================================================

# Project backup archives
/Backups/

# Local MediaPipe/package archives. Keep Packages/manifest.json and
# Packages/packages-lock.json tracked.
/Packages/*.tgz
/Packages/*.tar.gz

# Local third-party executable payloads. Keep wrapper scripts/configuration tracked.
/Tools/ffmpeg/bin/

# Unity installers are local machine artifacts.
/Tools/UnityInstallers/

# Research notes/scripts owned by Kiwi may remain trackable at Tools/Research root.
# Known third-party working copies are kept out of the main repository; record
# upstream URL/commit/license and any Kiwi-derived conclusions in tracked reports.
/Tools/Research/FaceMeshBarracuda/
/Tools/Research/OpenSeeFace/
/Tools/Research/sentis-samples/
/Tools/Research/Downloads/
/Tools/Research/Cache/
/Tools/Research/Temp/

# Local KlakSpout diagnostic working copy. This contains an embedded .git repository,
# native build products/intermediates, and historical diagnostic binaries.
# Keep it out of the main Kiwi repository. If its custom source delta is needed for
# provenance, preserve a patch/source-diff plus upstream commit and artifact SHA in a
# tracked KiwiValidation report instead of vendoring this entire workspace.
/Tools/KlakSpout_v206_diag/

# Generic installer packages generated/downloaded locally.
*.msi
*.msix
*.msm
*.msp
*.cab

# ============================================================
# KiwiValidation - generated runtime evidence only
# ============================================================

# External comparative-audit source mirrors are reproducible third-party inputs,
# not Kiwi Production source. Keep audit reports/manifests/scripts trackable while
# excluding the mirrored upstream repositories themselves.
/KiwiValidation/ExternalSourceAudit_*/sources/

# Keep validation source, validators, reports (.md/.txt/.json where intentional),
# manifests, and schemas trackable. Ignore bulky/generated runtime evidence.
KiwiValidation/**/*.mp4
KiwiValidation/**/*.log
KiwiValidation/**/*.csv
KiwiValidation/**/*.png
KiwiValidation/**/*.jpg
KiwiValidation/**/*.jpeg
KiwiValidation/**/*.webp
KiwiValidation/**/*.zip

# Chat archive output is managed separately from source control.
KiwiValidation/ChatReport/

# NOTE:
# Do not ignore KiwiValidation/LiveCameraPixelAudit/ as a whole. Generated files
# inside it are already excluded by the artifact-extension rules above, while any
# future scripts/source/report files remain visible to Git.
