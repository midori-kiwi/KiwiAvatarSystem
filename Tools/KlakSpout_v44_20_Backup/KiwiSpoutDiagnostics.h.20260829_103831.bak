{
    static std::atomic<int> value { 0 };
    return value;
}

inline std::atomic<int>& KiwiDiagStage()
{
    static std::atomic<int> value { 0 };
    return value;
}

inline std::atomic<long>& KiwiDiagLastHResult()
{
    static std::atomic<long> value { 0 };
    return value;
}

inline std::atomic<unsigned long long>& KiwiDiagSenderCreateCount()
{
    static std::atomic<unsigned long long> value { 0 };
