inline std::atomic<unsigned long long>& KiwiDiagNoFreeSkipCount()
{
    static std::atomic<unsigned long long> value { 0 };
    return value;
}

inline void KiwiDiagResetRuntimeCounters()
{
    KiwiDiagState().store(1, std::memory_order_relaxed);
    KiwiDiagStage().store(0, std::memory_order_relaxed);
    KiwiDiagLastHResult().store(0, std::memory_order_relaxed);
    KiwiDiagSenderCreateCount().store(0, std::memory_order_relaxed);
    KiwiDiagSubmitCount().store(0, std::memory_order_relaxed);
    KiwiDiagPublishCount().store(0, std::memory_order_relaxed);
    KiwiDiagDiscardCount().store(0, std::memory_order_relaxed);
    KiwiDiagNoFreeSkipCount().store(0, std::memory_order_relaxed);
}

